# ============================================================
# Aperio — Configuration des variables d'environnement
# ============================================================
# Copiez ce fichier en `.env` (développement) ou `.env.local`
# (surcharge locale) puis renseignez vos vraies valeurs.
#   Windows (PowerShell) :   Copy-Item .env.example .env.local
#   Linux/macOS :            cp .env.example .env.local
#
# ⚠️  NE JAMAIS committer ce fichier rempli, ni `.env`, ni
#   `.env.local` (ils sont déjà ignorés par .gitignore).
#   Utilisez `openssl rand -hex 32` pour générer un secret fort.
# ============================================================

# ------------------------------------------------------------
# 1. BASE / RUNTIME
# ------------------------------------------------------------

# URL publique de l'application — utilisée pour le sitemap,
# robots.txt, `metadataBase`, les images OG et le JSON-LD.
# En production, mettez l'URL réelle (ex: https://aperio.mg)
# SANS slash final.
NEXT_PUBLIC_URL=https://aperio.mg

# Mode d'exécution. Fourni automatiquement par Next/Node.
# Ne le définissez normalement PAS à la main.
#   development | production | test
NODE_ENV=development

# Port HTTP du serveur Next.js (fallback: 3000).
PORT=3000

# ------------------------------------------------------------
# 2. BASE DE DONNÉES (PostgreSQL + Drizzle)
# ------------------------------------------------------------

# Chaîne de connexion PostgreSQL (requise — l'application refuse
# de démarrer sans elle, voir db/index.ts).
# Format  : postgresql://<user>:<password>@<host>:<port>/<base>
# Exemple prod (Supabase/Neon/VPS) : utiliser l'URL SSL fournie
# par votre hébergeur.
DATABASE_URL=postgresql://postgres:password@localhost:5432/aperio

# ------------------------------------------------------------
# 3. AUTHENTIFICATION — JWT & Google OAuth
# ------------------------------------------------------------

# Clé de signature HS256 des sessions (requise — l'application
# refuse de démarrer sans elle, voir lib/auth.ts + lib/session.ts).
# Générez une valeur aléatoire : `openssl rand -hex 32`
# En production, conservez LA MÊME valeur pour toute la durée de
# vie du déploiement (la changer déconnecte tous les utilisateurs).
JWT_SECRET=change-me-generate-a-random-64-hex

# Google OAuth — connexion "Continuer avec Google" (optionnel).
# Créez le projet OAuth dans Google Cloud Console, puis :
#   Identifiants > OAuth 2.0 Client IDs > Clé client (Web).
GOOGLE_CLIENT_ID=
# Google OAuth 2.0 Client Secret.
GOOGLE_CLIENT_SECRET=

# (Facultatif) URI de redirection Google. Vide = calculée
# automatiquement depuis l'origine :  /api/auth/google/callback
# Ne la renseignez que si vous utilisez un domaine intermédiaire.
GOOGLE_REDIRECT_URI=

# ------------------------------------------------------------
# 4. E-MAILS — SMTP (activation de compte, mot de passe oublié,
#     confirmations de commande) via node-mailer
# ------------------------------------------------------------
# Sans SMTP configuré, aucun e-mail n'est simulé : les routes
# API renvoient une erreur explicite (lib/mailer.ts). Pour Gmail,
# utilisez un "Mot de passe d'application" (jamais le mot de
# passe du compte principal).

# Hôte SMTP (Gmail: smtp.gmail.com, Mailgun, SendGrid in-app, …)
SMTP_HOST=smtp.gmail.com
# Port SMTP : 587 (STARTTLS) ou 465 (SSL direct).
SMTP_PORT=587
# true si port 465 / SSL direct, sinon false.
SMTP_SECURE=false
# Utilisateur SMTP (adresse e-mail complète).
SMTP_USER=
# Mot de passe d'application (Gmail) ou clé API du fournisseur.
SMTP_PASS=
# (Facultatif) Expéditeur visible. Si vide, l'expéditeur par
# défaut est :  Aperio Galerie <SMTP_USER>
SMTP_FROM="Aperio Galerie <no-reply@aperio.mg>"

# ------------------------------------------------------------
# 5. PAIEMENTS — STRIPE (carte bancaire / Checkout hébergé)
# ------------------------------------------------------------

# Clé secrète Stripe (requise pour activer le paiement par carte).
#   Test     : sk_test_…
#   Production : sk_live_…  (Dashboard Stripe > Developers > API keys)
# Sans cette clé, les routes /api/checkout renvoient
# HTTP 501 « STRIPE_NOT_CONFIGURED ».
STRIPE_SECRET_KEY=

# Secret de signature des webhooks Stripe (obligatoire pour
# /api/webhooks/stripe qui marque les commandes comme payées).
#   CLI local :  stripe listen --forward-to localhost:3000/api/webhooks/stripe
#   Prod      :  Dashboard > Developers > Webhooks, puis remplir whsec_…
# Configurez aussi l'événement :  checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# (Optionnel / inutilisé actuellement) Clé PUBLIQUE Stripe pour
# un futur Checkout embarqué côté client. Non référencée dans le
# code aujourd'hui — à ignorer tant que le paiement reste hébergé.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------
# 6. PAIEMENTS — MOBILE MONEY (Madagascar)
# ------------------------------------------------------------
# Chaque intégration s'active dès que ses identifiants sont
# présents (isXConfigured()). Sans eux, la méthode de paiement
# est simplement désactivée — aucune erreur.

# --- Orange Money (API Orange Developer) ----------------
# Base64("<client_id>:<client_secret>") de la console Orange.
# Encodage : [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("id:secret"))
ORANGE_MONEY_AUTH_HEADER=
# Merchant key délivrée pour l'application Orange Money.
ORANGE_MONEY_MERCHANT_KEY=
# Segment de pays dans l'URL API (ex: "mg" pour Madagascar).
ORANGE_MONEY_COUNTRY=mg

# --- MVola (Yas / Telma Madagascar) -----------------------
# Consumer key & secret du portail développeur MVola.
MVOLA_CONSUMER_KEY=
MVOLA_CONSUMER_SECRET=
# Numéro MVola du marchand (format msisdn, ex: "0343500003").
MVOLA_MERCHANT_MSISDN=
# Base URL de l'API. Production: https://api.mvola.mg
# Sandbox: l'URL fournie par MVola dans leur documentation.
MVOLA_BASE_URL=https://api.mvola.mg
# Nom du partenaire/marchand affiché côté MVola (défaut "Aperio").
MVOLA_PARTNER_NAME=Aperio

# --- Airtel Money (Airtel Africa OpenAPI) ----------------
# Client ID & secret du portail développeur airtel.africa.
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# --- Sécurité Webhooks Mobile Money (Zero Trust) -----------
# Secret partagé exigé par /api/webhooks/{orange-money,mvola,airtel-money}.
# Générez avec `openssl rand -hex 32` et configurez la même valeur côté
# opérateur (header x-webhook-token ou Authorization: Bearer).
# Si vide, les webhooks restent ouverts en dev (warning) mais DOIVENT
# être renseignés en production, sinon un curl anonyme peut marquer
# une commande comme payée sans paiement réel.
# Option générique (recommandé) :
WEBHOOK_SECRET=
# Ou secrets spécifiques par opérateur (prioritaires si définis) :
# ORANGE_MONEY_WEBHOOK_TOKEN=
# MVOLA_WEBHOOK_TOKEN=
# AIRTEL_WEBHOOK_TOKEN=
# "production" => endpoint live (openapi.airtel.africa).
# Toute autre valeur / vide => sandbox UAT.
AIRTEL_ENV=sandbox
# Code pays (X-Country) — défaut "MG".
AIRTEL_COUNTRY=MG
# Devise (X-Currency) — défaut "MGA".
AIRTEL_CURRENCY=MGA

# ------------------------------------------------------------
# 7. API EXTERNES
# ------------------------------------------------------------

# Clé d'accès Unsplash (scripts/import-unsplash.ts uniquement —
# import des photos de démonstration). Requise seulement pour
# rejouer l'import ; inutile en production normale.
UNSPLASH_ACCESS_KEY=

# ------------------------------------------------------------
# 8. NON UTILISÉES (conservées pour référence)
# ------------------------------------------------------------

# Ancienne variable d'URL publique — jamais référencée dans le
# code. C'est NEXT_PUBLIC_URL qui fait foi.
NEXT_PUBLIC_APP_URL=